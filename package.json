{
  "name": "@ryanmakes/side-pane-studio",
  "version": "1.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "features": {
  "connectionRequirement": "required",
  "minAPI": "1.2.0"
},
  "displayName": "Side Pane Studio",
  "description": "Side Pane Studio is a visual builder for Dynamics 365 and Power Platforrm model-driven app side panes",
  "icon": "icon/icon.svg",
  "main": "index.html",
  "author": "Ryan Rettinger",
  "keywords": [
    "dataverse",
    "power-platform",
    "side-pane",
    "side-panes",
    "model-driven-apps",
    "power-platform-toolbox"
  ],
  "configurations": {
    "repository": "https://github.com/RyanMakesAndBreaksStuff/SidepaneStudio_PPTB",
    "website": "https://github.com/RyanMakesAndBreaksStuff/SidepaneStudio_PPTB/blob/main/documentation/user-manual.md",
    "readmeUrl": "https://raw.githubusercontent.com/RyanMakesAndBreaksStuff/SidepaneStudio_PPTB/main/README.md"
  },
  "contributors": [
    {
      "name": "Ryan Rettinger"
    }
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "debug": "vite build --mode development --watch"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-plugin-power-apps": "0.6.0",
    "@pptb/types": "1.2.5",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-promise": "7.3.0",
    "@eslint-react/eslint-plugin": "5.20.6",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.59.4",
    "vite": "^8.0.12",
    "vitest": "4.1.11"
  }
}